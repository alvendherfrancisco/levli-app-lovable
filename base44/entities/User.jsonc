{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "username": {
      "type": "string",
      "description": "Public display handle. Unique per app. Generated server-side by ensureProfile."
    },
    "username_lc": {
      "type": "string",
      "description": "Lower-cased copy of username for case-insensitive uniqueness checks."
    }
  },
  "required": [
    "role"
  ]
}
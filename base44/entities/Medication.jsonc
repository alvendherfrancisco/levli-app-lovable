{
  "name": "Medication",
  "type": "object",
  "properties": {
    "medication_name": {
      "type": "string",
      "description": "Brand or generic name from the catalogue"
    },
    "catalogue_id": {
      "type": "string",
      "description": "Reference to the medication catalogue entry ID"
    },
    "generic_name": {
      "type": "string",
      "description": "Generic active ingredient"
    },
    "molecular_class": {
      "type": "string",
      "description": "Molecular classification (peptide, peptide_analogue, protein, monoclonal_antibody, small_molecule, etc.)"
    },
    "route": {
      "type": "string",
      "description": "Route of administration for this medication entry"
    },
    "prescribed_dose": {
      "type": "number",
      "description": "Currently prescribed dose in mg (or other unit as specified)"
    },
    "dose_unit": {
      "type": "string",
      "description": "Unit of the prescribed dose (mg, mcg, units, IU, etc.)",
      "default": "mg"
    },
    "frequency": {
      "type": "string",
      "description": "Dosing frequency as entered (e.g., 'once weekly', 'twice daily')"
    },
    "schedule_kind": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "twice_weekly",
        "every_x_days",
        "as_directed"
      ],
      "description": "Which kind of schedule this medication runs on. Empty for records saved before schedules were stored. Decides which controls the schedule shows and which fields below carry a value."
    },
    "reminder_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Weekday numbers the dose falls on (0 = Sunday). One entry for a weekly schedule, two for twice weekly, empty for every day or no fixed day."
    },
    "reminder_time": {
      "type": "string",
      "description": "Local time of day the dose is due (HH:MM). Empty means no reminder."
    },
    "interval_days": {
      "type": "number",
      "description": "Days between doses: the user's own number for an every-X-days schedule, and the interval the other kinds run at (1 daily, 7 weekly, 3 twice weekly)."
    },
    "indication": {
      "type": "string",
      "description": "Treatment indication as prescribed"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "planned_end_date": {
      "type": "string",
      "format": "date"
    },
    "titration_stage": {
      "type": "string",
      "description": "Current titration stage label (as directed by prescriber)"
    },
    "prescriber_name": {
      "type": "string"
    },
    "prescriber_contact": {
      "type": "string"
    },
    "regimen_source": {
      "type": "string",
      "description": "Source of regimen data (user-entered, clinician-entered, imported, shot-history, shot-log)",
      "default": "user-entered"
    },
    "needs_details": {
      "type": "boolean",
      "default": false,
      "description": "Set when the regimen was created from a saved shot log rather than entered by the user, so its schedule and reminders still need adding. Cleared when the medication is saved from the Add / Edit Medication form."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "discontinued",
        "switched",
        "archived"
      ],
      "default": "active",
      "description": "Archived medications are hidden from the shot pickers but still shown on past shots and reports."
    },
    "discontinued_date": {
      "type": "string",
      "format": "date",
      "description": "Date the user marked this medication as stopped. Its schedule pauses and the adherence window ends here."
    },
    "archived_date": {
      "type": "string",
      "format": "date",
      "description": "Date the medication was archived. Its shot history is kept and stays visible in history and reports."
    },
    "custom_doses": {
      "type": "array",
      "description": "Doses the user logged through 'Other' for this medication, offered as dose chips next time",
      "items": {
        "type": "number"
      }
    },
    "shots_linked_count": {
      "type": "number",
      "description": "How many shot logs were linked when this medication was created from shot history"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "medication_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
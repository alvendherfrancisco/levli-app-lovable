{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "height_ft": {
      "type": "string",
      "description": "Legacy display entry for feet. Canonical height lives in height_cm."
    },
    "height_in": {
      "type": "string",
      "description": "Legacy display entry for inches. Canonical height lives in height_cm."
    },
    "height_cm": {
      "type": "number",
      "description": "Canonical height in CENTIMETRES. Displayed as cm or ft/in according to height_unit."
    },
    "goal_weight": {
      "type": "string",
      "description": "Legacy goal entry in the display unit. Canonical goal lives in goal_weight_kg."
    },
    "goal_weight_kg": {
      "type": "number",
      "description": "Canonical goal weight in KILOGRAMS."
    },
    "days_between": {
      "type": "string"
    },
    "days_between_override": {
      "type": "string",
      "description": "Prescriber-directed override for the days between shots. Empty means the app uses the medication's own interval from the central medications config."
    },
    "shot_schedule": {
      "type": "object",
      "description": "The schedule chosen for the person's medication: how often it is taken, the day or interval it runs on, and an optional reminder time. Levli works the next dose out from the last dose logged plus interval_days; the chosen days are the anchor, not the calculation.",
      "properties": {
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "twice_weekly",
            "every_x_days",
            "as_directed"
          ],
          "description": "Dosing frequency key, from the medication's own catalogue entry."
        },
        "medication": {
          "type": "string",
          "description": "The product this schedule belongs to. A change of medication replaces the schedule with the new product's own default."
        },
        "days": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Chosen weekday numbers (0 = Sunday) for a weekly or twice-weekly schedule. Empty for every other frequency."
        },
        "interval_days": {
          "type": "number",
          "description": "Days between doses: 1 for daily, 7 for weekly, 3 for twice weekly, or the number entered for every_x_days. null when the frequency sets no interval (as directed), so the product's own label interval applies."
        },
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "First dose date of an every_x_days schedule. Empty for every other frequency."
        },
        "reminder_time": {
          "type": "string",
          "description": "Local time (HH:MM) to be reminded, or empty for no reminder."
        }
      }
    },
    "liquid_unit": {
      "type": "string"
    },
    "height_unit": {
      "type": "string",
      "description": "Display preference for height: cm or in."
    },
    "weight_unit": {
      "type": "string",
      "description": "Display preference for weight: kg or lb. Never the storage unit."
    },
    "default_medication": {
      "type": "string"
    },
    "dark_mode": {
      "type": "boolean"
    },
    "onboarding_completed": {
      "type": "boolean"
    },
    "units_migrated_at": {
      "type": "string",
      "description": "ISO timestamp when legacy height/goal values were converted to canonical cm/kg."
    },
    "unit_check_status": {
      "type": "string",
      "description": "One-time kg/lb check flow: '' (not asked), 'pending', 'converted', 'kept_lb'."
    },
    "birthdate": {
      "type": "string",
      "format": "date",
      "description": "Account holder's date of birth (used for the 18+ age gate)"
    },
    "gdpr_consent_date": {
      "type": "string",
      "description": "ISO timestamp when GDPR Art. 9 special-category consent was given"
    },
    "gdpr_privacy_policy_version": {
      "type": "string",
      "description": "Version identifier of the privacy policy the user consented to"
    },
    "age_confirmed_at": {
      "type": "string",
      "description": "ISO timestamp when the user confirmed in onboarding that they are 18 or older"
    },
    "parental_consent_date": {
      "type": "string",
      "description": "ISO timestamp when a parent/guardian consented on behalf of a minor"
    },
    "parental_consent_name": {
      "type": "string",
      "description": "Name of the parent/guardian who provided consent for a minor"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "free",
        "monthly",
        "yearly",
        "lifetime"
      ],
      "default": "free",
      "description": "Current subscription plan"
    },
    "subscription_status": {
      "type": "string",
      "description": "Subscription status: active, trialing, past_due, canceled, inactive, none"
    },
    "premium_until": {
      "type": "string",
      "description": "ISO date when premium access expires (null/empty for lifetime or active recurring plans)"
    },
    "first_name": {
      "type": "string",
      "description": "User's first name"
    },
    "prescriber_name": {
      "type": "string",
      "description": "Prescriber's name, saved in Profile"
    },
    "prescriber_contact": {
      "type": "string",
      "description": "Prescriber's phone number or email, saved in Profile. Opened by the Contact prescriber button."
    },
    "weight_tracking_opted_in": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user opted into weight tracking during onboarding"
    },
    "custom_doses": {
      "type": "array",
      "description": "Doses the user added themselves, one entry per medication, offered as dose chips next time",
      "items": {
        "type": "object",
        "properties": {
          "medication": {
            "type": "string"
          },
          "dose": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
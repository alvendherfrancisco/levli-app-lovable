{
  "type": "object",
  "properties": {
    "height_ft": {
      "type": "string"
    },
    "height_in": {
      "type": "string"
    },
    "goal_weight": {
      "type": "string"
    },
    "days_between": {
      "type": "string"
    },
    "liquid_unit": {
      "type": "string"
    },
    "height_unit": {
      "type": "string"
    },
    "weight_unit": {
      "type": "string"
    },
    "default_medication": {
      "type": "string"
    },
    "notifications_enabled": {
      "type": "boolean"
    },
    "dark_mode": {
      "type": "boolean"
    },
    "onboarding_completed": {
      "type": "boolean"
    },
    "birthdate": {
      "type": "string",
      "format": "date",
      "description": "Account holder's date of birth (used for paediatric account detection)"
    },
    "gdpr_consent_date": {
      "type": "string",
      "description": "ISO timestamp when GDPR Art. 9 special-category consent was given"
    },
    "gdpr_privacy_policy_version": {
      "type": "string",
      "description": "Version identifier of the privacy policy the user consented to"
    },
    "parental_consent_date": {
      "type": "string",
      "description": "ISO timestamp when a parent/guardian consented on behalf of a minor"
    },
    "parental_consent_name": {
      "type": "string",
      "description": "Name of the parent/guardian who provided consent for a minor"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "free",
        "monthly",
        "yearly",
        "lifetime"
      ],
      "default": "free",
      "description": "Current subscription plan"
    },
    "subscription_status": {
      "type": "string",
      "description": "Subscription status: active, trialing, past_due, canceled, inactive, none"
    },
    "premium_until": {
      "type": "string",
      "description": "ISO date when premium access expires (null/empty for lifetime or active recurring plans)"
    },
    "first_name": {
      "type": "string",
      "description": "User's first name for personalized notification copy"
    },
    "notif_shot_reminders": {
      "type": "boolean",
      "default": true,
      "description": "Core shot due/overdue reminders (on by default)"
    },
    "notif_checkin_reminders": {
      "type": "boolean",
      "default": false,
      "description": "Symptom/mood check-in nudges (off by default, a few times a week)"
    },
    "notif_weight_reminders": {
      "type": "boolean",
      "default": false,
      "description": "Weekly weight logging reminder (off unless user opted into weight tracking)"
    },
    "notif_inventory_alerts": {
      "type": "boolean",
      "default": true,
      "description": "Refill/low-inventory alerts (on by default)"
    },
    "notif_reengagement": {
      "type": "boolean",
      "default": false,
      "description": "Supportive re-engagement nudge after 5+ days of inactivity (off by default)"
    },
    "weight_tracking_opted_in": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user opted into weight tracking during onboarding"
    },
    "custom_doses": {
      "type": "array",
      "description": "Doses the user added themselves, one entry per medication, offered as dose chips next time",
      "items": {
        "type": "object",
        "properties": {
          "medication": {
            "type": "string"
          },
          "dose": {
            "type": "number"
          }
        }
      }
    }
  },
  "name": "UserProfile",
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "DayMetric",
  "type": "object",
  "properties": {
    "day_key": {
      "type": "string",
      "description": "YYYY-MM-DD"
    },
    "weight": {
      "type": "number",
      "description": "Weight in KILOGRAMS (canonical). Rows logged before the kg migration carry weight_unit to say how to read them."
    },
    "weight_unit": {
      "type": "string",
      "description": "Unit the stored weight is expressed in. 'kg' for canonical rows; a legacy row keeps the unit it was entered in until it is migrated."
    },
    "weight_source_unit": {
      "type": "string",
      "description": "The unit the person originally typed, kept for audit after a value is converted to kg."
    },
    "weight_unit_check": {
      "type": "string",
      "description": "Flag for the one-time kg/lb check: '' (none), 'migrated', 'converted', 'kept_lb', 'undone'."
    },
    "weight_revert_value": {
      "type": "number",
      "description": "The value this entry held before a one-tap unit conversion, so the conversion can be undone exactly."
    },
    "weight_revert_unit": {
      "type": "string",
      "description": "The unit weight_revert_value is expressed in."
    },
    "calories": {
      "type": "number"
    },
    "protein": {
      "type": "number"
    },
    "water": {
      "type": "number"
    },
    "fiber": {
      "type": "number"
    },
    "carbs": {
      "type": "number"
    },
    "exercise_min": {
      "type": "number"
    },
    "progress_photo": {
      "type": "string"
    },
    "side_effects": {
      "type": "string"
    }
  },
  "required": [
    "day_key"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
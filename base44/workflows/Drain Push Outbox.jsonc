{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "drain_push_outbox",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "drain": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-push",
            "args": {
              "trigger": "cron"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send queued pushes"
          }
        }
      }
    ]
  },
  "name": "Drain Push Outbox",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Sends queued remote pushes to Vapor/APNs and retries failures"
}